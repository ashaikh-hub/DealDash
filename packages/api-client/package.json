{
  "name": "@dealdash/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed API client generated from the API's OpenAPI contract (no duplicated API types in apps)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dealdash/types": "workspace:*",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@dealdash/tsconfig": "workspace:*",
    "openapi-typescript": "^7.9.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
