{
  "name": "@dealdash/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain types, enums and catalogues (roles, permissions, audiences)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint: see root eslint config\"",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@dealdash/tsconfig": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
