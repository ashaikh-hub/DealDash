# DealDash local environment. Copy to `.env` (never commit `.env`).
# Placeholders only. Put your own values in `.env` locally.

# --- Database (native Windows PostgreSQL; Docker is NOT required) ---
# Application user with least privilege on dealdash_dev (see README for creation commands).
DATABASE_URL=
# Separate test database. Tests refuse to run unless the database name ends with "_test".
TEST_DATABASE_URL=
# Superuser connection used ONLY by setup scripts to create roles/databases/extensions. Not used by the app.
ADMIN_DATABASE_URL=

# --- API ---
NODE_ENV=
API_PORT=
API_PUBLIC_URL=
MERCHANT_APP_URL=
# Comma-separated allowed browser origins (the five Next.js apps).
CORS_ORIGINS=
# Secret used to sign/derive tokens. Generate a long random value locally.
SESSION_SECRET=
# Secret used to encrypt sensitive fields at rest (32+ chars).
FIELD_ENCRYPTION_KEY=

# --- Provider adapters (mock by default; no vendor is selected yet) ---
SMS_PROVIDER=
EMAIL_PROVIDER=
PUSH_PROVIDER=
PAYMENT_PROVIDER=
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=
VIDEO_PROVIDER=
MAPS_PROVIDER=
# Settlement payouts: manual (finance records bank references; the default) or mock (development only).
PAYOUT_PROVIDER=

# --- Stage 9: deployment tier and runtime hardening (docs/PRODUCTION_RUNBOOK.md) ---
# local | development | test | staging | production. With NODE_ENV=production the API refuses to start on an unsafe
# configuration (development adapters, dev/test database, no TLS, weak secrets, http origins, no rate limit, non-JSON logs).
APP_ENV=
# Staging only (UAT before vendors are contracted): allow development adapters. Refused in production.
ALLOW_MOCK_PROVIDERS=
# Requests per minute per client IP: whole API, and sign-in / OTP routes. 0 = off (local only; required in production).
RATE_LIMIT_PER_MINUTE=
AUTH_RATE_LIMIT_PER_MINUTE=
# Reverse-proxy hops in front of the API (so client IPs are real). 0 when reached directly.
TRUST_PROXY_HOPS=
# json (production: one structured, redacted line per event) or pretty (local).
LOG_FORMAT=
# Shared secrets (32+ chars) that sign provider callbacks. Unset = those callbacks are refused.
PAYOUT_WEBHOOK_SECRET=
NOTIFY_WEBHOOK_SECRET=

# --- Frontend apps (each Next.js app) ---
NEXT_PUBLIC_API_URL=
