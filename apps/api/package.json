{
  "name": "@dealdash/api",
  "version": "0.1.0",
  "private": true,
  "description": "DealDash API: one NestJS modular monolith (HTTP API + background worker)",
  "scripts": {
    "dev": "node --watch -r @swc-node/register --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset dev",
    "db:test:reset": "tsx scripts/db.ts reset test",
    "db:setup": "tsx scripts/db.ts setup",
    "db:status": "tsx scripts/db.ts status",
    "db:postgis": "tsx scripts/db.ts postgis",
    "openapi:generate": "node -r @swc-node/register scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@dealdash/analytics": "workspace:*",
    "@dealdash/config": "workspace:*",
    "@dealdash/localization": "workspace:*",
    "@dealdash/types": "workspace:*",
    "@dealdash/validation": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "nestjs-zod": "^5.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@dealdash/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
